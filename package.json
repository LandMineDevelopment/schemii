{
  "name": "schemii-frontend-tests",
  "private": true,
  "type": "module",
  "imports": {
    "#model/*": "./src/schemii/schemoo/web/*",
    "#common/*": "./src/schemii/common/web/assets/*"
  },
  "scripts": {
    "test": "node --test tests/frontend/*.test.js testing/harness/*.test.mjs scripts/ci/*.test.mjs",
    "test:ci": "node --test --test-reporter=spec --test-reporter=./scripts/ci/node-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=artifacts/ci-timing/node.jsonl tests/frontend/*.test.js testing/harness/*.test.mjs scripts/ci/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
